#!/usr/bin/env python3
"""Super+Space launcher on KDE Plasma: rofi with apps (drun) and files (Baloo).

  kde-launcher           toggle the launcher (open it, or close it if it is open)
  kde-launcher --files   rofi script mode: list Baloo-indexed files / open the picked one

Uses only ~/.config/rofi/kde-nordicforest.rasi; the mango/Hyprland config.rasi is never read.
"""
import mimetypes, os, signal, subprocess, sys

HOME = os.path.expanduser("~")
THEME = os.path.join(HOME, ".config/rofi/kde-nordicforest.rasi")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PIDFILE = os.path.join(RUNTIME, "kde-launcher-rofi.pid")
MIMEICONS = os.path.join(HOME, ".local/share/icons/Papirus/24x24/mimetypes")


def running_pid():
    """pid of the rofi this launcher started, or None."""
    try:
        pid = int(open(PIDFILE).read().strip())
        with open(f"/proc/{pid}/comm") as f:
            return pid if f.read().strip() == "rofi" else None
    except (OSError, ValueError):
        return None


def toggle():
    pid = running_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        return
    me = os.path.realpath(__file__)
    os.execvp("rofi", [
        "rofi", "-config", THEME, "-pid", PIDFILE,
        "-modes", f"combi,drun,files:{me} --files",
        "-combi-modes", "drun,files",
        "-show", "combi",
    ])


def icon_for(path, known):
    if os.path.isdir(path):
        return "folder"
    mime = mimetypes.guess_type(path, strict=False)[0]
    if mime:
        name = mime.replace("/", "-")
        if name in known:
            return name
        generic = mime.split("/")[0] + "-x-generic"
        if generic in known:
            return generic
    return "text-x-generic" if "text-x-generic" in known else "unknown"


def list_files():
    try:
        known = {f[:-4] for f in os.listdir(MIMEICONS) if f.endswith(".svg")}
    except OSError:
        known = set()
    # A single-space query returns every indexed file under -d.
    try:
        out = subprocess.run(["baloosearch6", "-l", "100000", "-d", HOME, " "],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return
    w = sys.stdout.write
    for path in out.splitlines():
        if not path.startswith("/"):
            continue  # skips the "Elapsed: ..." line
        folder = os.path.dirname(path).replace(HOME, "~", 1)
        label = f"{os.path.basename(path)}  {folder}".replace("\n", " ")
        w(f"{label}\0icon\x1f{icon_for(path, known)}\x1finfo\x1f{path}\n")


def files_mode():
    if os.environ.get("ROFI_RETV", "0") == "0":
        list_files()
        return
    path = os.environ.get("ROFI_INFO", "")
    if path and os.path.exists(path):
        subprocess.Popen(["xdg-open", path], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Printing nothing makes rofi close.


if __name__ == "__main__":
    if "--files" in sys.argv[1:]:
        files_mode()
    else:
        toggle()
