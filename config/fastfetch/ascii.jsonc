// Pine Cabin fastfetch. config.jsonc and ascii.jsonc are identical: both use
// the text logo logos/cabin-lights.txt (undo: cabin.txt or logos/alpine.txt, emblem.png unused). Keep them in sync.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/cabin-lights.txt",
    "padding": {
      "top": 9,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "#7f9a6e",
      "2": "#c88a52",
      "3": "#869180",
      "5": "#f0bc72",
      "6": "#8a5e36"
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "#7f9a6e",
      "title": "#c88a52",
      "output": "#c8d0c2",
      "separator": "#3d4a3c"
    },
    "percent": {
      "color": {
        "green": "#7f9a6e",
        "yellow": "#d9a26e",
        "red": "#b5574a"
      }
    },
    "bar": {
      "color": {
        "elapsed": "#c88a52",
        "total": "#3d4a3c"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "#c88a52",
        "at": "#3d4a3c",
        "host": "#d9a26e"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;61;74;60m\u256d\u2500 \u001b[38;2;200;138;82msystem \u001b[38;2;61;74;60m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf30a  \u001b[38;2;134;145;128mos        \u001b[0m",
      "format": "{name} {version-id}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf013  \u001b[38;2;134;145;128mkernel    \u001b[0m",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udfd6  \u001b[38;2;134;145;128mpackages  \u001b[0m",
      "format": "{rpm} rpm \u00b7 {flatpak-all} flatpak"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb82\udd54  \u001b[38;2;134;145;128muptime    \u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf489  \u001b[38;2;134;145;128mshell     \u001b[0m",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "locale",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf1ab  \u001b[38;2;134;145;128mlocale    \u001b[0m",
      "format": "{result}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;61;74;60m\u251c\u2500 \u001b[38;2;200;138;82mdesktop \u001b[38;2;61;74;60m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "de",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf108  \u001b[38;2;134;145;128mdesktop   \u001b[0m",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf2d2  \u001b[38;2;134;145;128mwm        \u001b[0m",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "display",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udf79  \u001b[38;2;134;145;128mdisplay   \u001b[0m",
      "format": "{width}x{height} @ {refresh-rate} Hz \u00b7 {name}"
    },
    {
      "type": "theme",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udfd8  \u001b[38;2;134;145;128mtheme     \u001b[0m"
    },
    {
      "type": "icons",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udf81  \u001b[38;2;134;145;128micons     \u001b[0m"
    },
    {
      "type": "font",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf031  \u001b[38;2;134;145;128mfont      \u001b[0m",
      "format": "{font3}"
    },
    {
      "type": "cursor",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\uddbf  \u001b[38;2;134;145;128mcursor    \u001b[0m",
      "format": "{theme} \u00b7 {size}px"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf120  \u001b[38;2;134;145;128mterminal  \u001b[0m",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "media",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb81\udf5a  \u001b[38;2;134;145;128mplaying   \u001b[0m",
      "format": "{artist} \u2013 {title}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;61;74;60m\u251c\u2500 \u001b[38;2;200;138;82mhardware \u001b[38;2;61;74;60m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf4bc  \u001b[38;2;134;145;128mcpu       \u001b[0m",
      "temp": true,
      "format": "{name} \u00b7 {temperature}"
    },
    {
      "type": "cpuusage",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb83\udee0  \u001b[38;2;134;145;128mcpu usage \u001b[0m",
      "waitTime": 60,
      "format": "{avg}"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udf79  \u001b[38;2;134;145;128mgpu       \u001b[0m",
      "temp": true,
      "hideType": "integrated",
      "format": "{name} \u00b7 {temperature}"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf2db  \u001b[38;2;134;145;128mdriver    \u001b[0m",
      "temp": true,
      "hideType": "integrated",
      "format": "{driver~0,6} {driver~21}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uefc5  \u001b[38;2;134;145;128mmemory    \u001b[0m"
    },
    {
      "type": "swap",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb82\udfcd  \u001b[38;2;134;145;128mswap      \u001b[0m",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udeca  \u001b[38;2;134;145;128mdisk /    \u001b[0m",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "loadavg",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb81\udcc5  \u001b[38;2;134;145;128mload      \u001b[0m",
      "format": "{loadavg1} \u00b7 {loadavg2} \u00b7 {loadavg3}"
    },
    {
      "type": "processes",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\uf013  \u001b[38;2;134;145;128mprocesses \u001b[0m",
      "format": "{result}"
    },
    {
      "type": "battery",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb80\udc79  \u001b[38;2;134;145;128mbattery   \u001b[0m"
    },
    {
      "type": "localip",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb82\ude5f  \u001b[38;2;134;145;128mlocal ip  \u001b[0m",
      "format": "{ipv4}",
      "showIpv4": true,
      "defaultRouteOnly": true
    },
    {
      "type": "localip",
      "key": "\u001b[38;2;61;74;60m\u2502 \u001b[38;2;127;154;110m\udb82\ude5f  \u001b[38;2;134;145;128mtailscale \u001b[0m",
      "format": "{ipv4}",
      "showIpv4": true,
      "showIpv6": false,
      "namePrefix": "tailscale0",
      "defaultRouteOnly": false
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;61;74;60m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;20;24;21m\u2588\u2588\u2588\u2588\u001b[38;2;28;34;29m\u2588\u2588\u2588\u2588\u001b[38;2;43;53;44m\u2588\u2588\u2588\u2588\u001b[38;2;61;74;60m\u2588\u2588\u2588\u2588\u001b[38;2;127;154;110m\u2588\u2588\u2588\u2588\u001b[38;2;134;145;128m\u2588\u2588\u2588\u2588\u001b[38;2;200;138;82m\u2588\u2588\u2588\u2588\u001b[38;2;217;162;110m\u2588\u2588\u2588\u2588\u001b[38;2;200;208;194m\u2588\u2588\u2588\u2588\u001b[0m"
    }
  ]
}
