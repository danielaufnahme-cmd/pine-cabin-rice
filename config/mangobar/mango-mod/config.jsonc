// Generated by MangoWM Mod for Mangobar
{
  "battery": {
    "format": "{icon} {percent}%",
    "icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "clock": {
    "format": "{:L%a %d %b  %H:%M}"
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 3
  },
  "height": 28,
  "layer": "top",
  "layout": {
    "format": "{}"
  },
  "memory": {
    "format": "󰘚 {}%",
    "interval": 5
  },
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "workspaces",
    "layout",
    "window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],
  "network": {
    "format": "{icon} {ifname}",
    "format-disconnected": "{icon}",
    "format-wifi": "{signal} {ssid}",
    "icon-disconnected": "󰤭",
    "icon-ethernet": "󰈀",
    "icon-wifi": "󰖩",
    "signal-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "window": {
    "format": "{}",
    "max-length": 432
  },
  "workspaces": {
    "hide-empty": true,
    "on-click": "activate",
    "on-click-right": "toggle"
  }
}
